# --- Zoho OAuth (required) ---
# Create a Server-based Application at https://api-console.zoho.com
# Scopes needed: ZohoProjects.portals.READ, ZohoProjects.projects.READ,
#                ZohoProjects.tasks.READ, ZohoCRM.modules.ALL, ZohoCRM.users.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REGION=com

# --- Zoho Projects ---
ZOHO_PORTAL_ID=
# Optional: if set, tasks are pulled from just this project.
# If blank, the app aggregates tasks across every project (slower).
ZOHO_PROJECTS_PROJECT_ID=

# --- Zoho CRM ---
ZOHO_CRM_ORG_ID=

# --- QuickBooks Time (T-Sheets) (optional - time tracking features) ---
# NOT developer.intuit.com - that's a different Intuit product (QuickBooks
# Online) and doesn't support QuickBooks Time apps. Generate this from
# inside QuickBooks Time itself: Feature Add-ons -> API -> Add a new
# application. Use save_tsheets_token.py to fill this in without editing
# this file by hand.
TSHEETS_ACCESS_TOKEN=

# --- Local cache database ---
# Defaults to a local SQLite file - swap for Postgres/MySQL in production.
DATABASE_URL=sqlite:///capacity_planner.db

# --- Behavior ---
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15

# --- Access control ---
# One shared password the whole team uses to view the dashboard. Leave
# blank to disable the password screen (e.g. for local development).
APP_PASSWORD=
